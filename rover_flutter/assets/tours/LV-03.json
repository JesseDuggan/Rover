{
  "title": "Arts District & Brewery Row",
  "theme": "artists, makers and Brewery Row",
  "geometrySource": "© OpenStreetMap contributors, ODbL — https://www.openstreetmap.org/copyright",
  "chapters": [
    {
      "name": "Community Healing Garden",
      "photo": {"asset": "garden", "caption": "a memorial stone and flowers in the Healing Garden"},
      "opening": "This garden grew out of a very particular moment. Las Vegas residents came together after October 1, 2017, to make a place where people could remember the lives lost.",
      "sources": {
        "Community Healing Garden": "https://www.lasvegasnevada.gov/Residents/Parks-Facilities/Healing-Garden"
      },
      "angles": [
        {
          "interests": [
            "history",
            "culture"
          ],
          "text": "The memorial sits in the neighbourhood where volunteers built it. Take a moment here before walking on."
        },
        {
          "interests": [
            "nature",
            "art"
          ],
          "text": "Notice how planting gives the memorial a living form. What you see here changes with the seasons."
        }
      ],
      "point": [
        36.1596403,
        -115.1509845
      ]
    },
    {
      "name": "The Arts Factory",
      "photo": {"asset": "LV-03", "caption": "a mural in the Las Vegas Arts District"},
      "opening": "A warehouse became a home for working artists. Inside the Arts Factory, a visitor can move between studios and galleries under one roof.",
      "sources": {
        "The Arts Factory": "https://www.theartsfactorylv.com/"
      },
      "angles": [
        {
          "interests": [
            "architecture",
            "history"
          ],
          "text": "Look at how much space the old warehouse gives its new occupants. A building made for moving goods can now hold a whole community of makers."
        },
        {
          "interests": [
            "art",
            "culture"
          ],
          "text": "Try following a single colour from one studio window to the next. Painters, photographers and other artists use the same building in very different ways."
        }
      ],
      "point": [
        36.159175383333334,
        -115.15342326666666
      ]
    },
    {
      "name": "Antique Alley Mall",
      "opening": "Main Street offers a different kind of local archive. At Antique Alley Mall, objects that once furnished homes or filled shop windows find another audience.",
      "sources": {
        "Antique Alley Mall": "https://www.antiquealleymall.com/"
      },
      "angles": [
        {
          "interests": [
            "art",
            "architecture"
          ],
          "text": "Pick out one object by its shape alone. Old lettering, furniture legs and light fixtures each carry clues to the tastes of their time."
        },
        {
          "interests": [
            "history",
            "hidden gems"
          ],
          "text": "Look for the traces of use. A worn handle can say more about the everyday life of an object than its price tag."
        }
      ],
      "point": [
        36.1575384,
        -115.15406232
      ]
    },
    {
      "name": "CraftHaus",
      "opening": "Brewery Row adds another kind of workshop to the Arts District. At the CraftHaus taproom, the material people come to sample is beer.",
      "sources": {
        "CraftHaus": "https://www.crafthausbrewery.com/"
      },
      "angles": [
        {
          "interests": [
            "food",
            "coffee"
          ],
          "text": "Look for the descriptions of malt, hops and yeast. They are clues to flavour even if you are just passing by."
        },
        {
          "interests": [
            "culture",
            "art"
          ],
          "text": "Compare the lettering on the brewery sign with the gallery signs you passed. Each maker needs a way to be noticed from the pavement."
        }
      ],
      "point": [
        36.157301520000004,
        -115.15286036
      ]
    },
    {
      "name": "Able Baker Brewing",
      "opening": "The last stop on this Main Street walk is a brewery whose name points back to Nevada’s atomic testing history.",
      "sources": {
        "Able Baker Brewing": "https://ablebakerbrewing.com/"
      },
      "angles": [
        {
          "interests": [
            "history",
            "unusual facts"
          ],
          "text": "Able and Baker were names used for early atomic tests. Here those words have found a second life on a neighbourhood brewery sign."
        },
        {
          "interests": [
            "food",
            "culture"
          ],
          "text": "The name travels with the beer. Look for the same two words on the building, the tap list and the labels."
        }
      ],
      "point": [
        36.15303065,
        -115.15411795
      ]
    }
  ],
