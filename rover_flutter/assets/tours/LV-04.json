{
  "title": "Best Bites on the Las Vegas Strip",
  "theme": "food and spectacle along the Strip",
  "geometrySource": "© OpenStreetMap contributors, ODbL — https://www.openstreetmap.org/copyright",
  "chapters": [
    {
      "name": "Hershey’s Chocolate World",
      "photo": {"asset": "hershey", "caption": "the New York-New York resort at night"},
      "opening": "Start at New York-New York. A Manhattan skyline draws your eye upward, while a chocolate shop gives visitors a reason to linger at street level.",
      "sources": {
        "Hershey’s Chocolate World": "https://www.chocolateworld.com/locations/las-vegas.html"
      },
      "angles": [
        {
          "interests": [
            "food"
          ],
          "text": "A familiar sweet can become a souvenir simply by changing its scale. Look for how the displays play with that idea."
        },
        {
          "interests": [
            "architecture",
            "art"
          ],
          "text": "See how many different rooflines you can trace before looking back down at the chocolate storefront."
        }
      ],
      "point": [
        36.1018144,
        -115.17340715
      ]
    },
    {
      "name": "The Park",
      "opening": "The Park links the Strip to T-Mobile Arena. Diners and people on their way to a show share this open-air stretch.",
      "sources": {
        "The Park": "https://www.mgmresorts.com/en/things-to-do/the-park-las-vegas.html"
      },
      "angles": [
        {
          "interests": [
            "food",
            "culture"
          ],
          "text": "Look for the difference between a counter where someone picks up a burger and a table where a group settles in before a game."
        },
        {
          "interests": [
            "architecture",
            "nature"
          ],
          "text": "Notice where shade and seating change the pace of the crowd. A place to pause can shape a street just as much as a building."
        }
      ],
      "point": [
        36.1032394,
        -115.1737363
      ]
    },
    {
      "name": "Eataly at Park MGM",
      "photo": {"asset": "LV-04", "caption": "the Eataly entrance at Park MGM"},
      "opening": "At Park MGM, an Italian marketplace brings food counters, shops and sit-down dining together.",
      "sources": {
        "Eataly at Park MGM": "https://parkmgm.mgmresorts.com/en/restaurants/eataly.html"
      },
      "angles": [
        {
          "interests": [
            "food",
            "coffee"
          ],
          "text": "Pizza and pasta can be a meal here, but ingredients are also part of the display. Think about what you could take home and cook yourself."
        },
        {
          "interests": [
            "architecture",
            "culture"
          ],
          "text": "The marketplace gives people several reasons to use the same room. A shopper, a diner and someone watching a cook can all stand within a few steps of one another."
        }
      ],
      "point": [
        36.104500200000004,
        -115.1733464
      ]
    },
    {
      "name": "The Cosmopolitan",
      "opening": "Inside the Cosmopolitan, The Chandelier turns a lighting fixture into the setting for a bar. The outdoor listening point is along the resort frontage.",
      "sources": {
        "The Cosmopolitan": "https://cosmopolitanlasvegas.mgmresorts.com/en/nightlife/the-chandelier.html"
      },
      "angles": [
        {
          "interests": [
            "art",
            "architecture"
          ],
          "text": "Imagine stepping inside the outline of a chandelier. Its strands mark the edge of the space while allowing light to pass through."
        },
        {
          "interests": [
            "food",
            "culture"
          ],
          "text": "Here the setting is part of what people come to taste. Even before a drink arrives, the room gives the occasion a character of its own."
        }
      ],
      "point": [
        36.1096651,
        -115.1733776
      ]
    },
    {
      "name": "Bellagio Patisserie",
      "opening": "Finish at the Bellagio frontage. Inside, the patisserie makes chocolate part of the spectacle, alongside pastries and gelato.",
      "sources": {
        "Bellagio Patisserie": "https://bellagio.mgmresorts.com/en/restaurants/bellagio-patisserie.html"
      },
      "angles": [
        {
          "interests": [
            "food"
          ],
          "text": "Think back to the packaged sweets at the start. At this end of the walk, chocolate shows up as pastry work and display."
        },
        {
          "interests": [
            "art",
            "architecture"
          ],
          "text": "From a skyline to a chandelier to a chocolate display, this walk has played with scale. Which detail would you photograph to remember it?"
        }
      ],
      "point": [
        36.112095,
        -115.1746005
      ]
    }
  ],
