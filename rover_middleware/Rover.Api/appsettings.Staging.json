{
  "Rover": {
    "Storage": {
      "Mode": "PostgreSql",
      "PostgreSql": {
        "ConnectionString": ""
      }
    },
    "Authentication": {
      "Mode": "Cognito",
      "Cognito": {
        "Authority": "",
        "Audience": ""
      }
    },
    "Cors": {
      "AllowedOrigins": ""
    },
    "Routing": {
      "Mode": "Google",
      "Google": {
        "ApiKey": "",
        "Endpoint": "https://routes.googleapis.com/directions/v2:computeRoutes"
      }
    },
    "Discovery": {
      "Mode": "GooglePlaces"
    },
    "LocalDiscovery": {
      "Mode": "GooglePlaces",
      "Enabled": true,
      "Mapbox": {
        "Country": "ca",
        "LimitPerCategory": 6,
        "MinimumStops": 3,
        "MaximumStops": 5,
        "RadiusDegrees": 0.025,
        "MaximumDistanceMeters": 2500
      }
    },
    "Conversation": {
      "Mode": "Mock",
      "OpenAI": {
        "Model": "gpt-5-mini"
      }
    },
    "DataRetention": {
      "WalkHistoryDays": 365,
      "AuditEventDays": 730
    }
  },
  "ElevenLabs": {
    "Enabled": true,
    "VoiceId": "",
    "ModelId": "",
    "OutputFormat": "mp3_44100_128",
    "Stability": 0.45,
    "Similarity": 0.75,
    "Style": 0,
    "SpeakerBoost": true,
    "RequestTimeoutSeconds": 20,
    "MaximumCharactersPerRequest": 1800,
    "DailyCharacterLimitPerUser": 12000,
    "MonthlyCharacterLimit": 250000,
    "CacheEnabled": true,
    "FallbackEnabled": true,
    "CacheDirectory": "work/generated-audio-cache"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
