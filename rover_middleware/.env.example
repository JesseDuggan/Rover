# Copy this file to .env.local and fill in local-only secrets.
# .env.local is ignored by git.

ROVER_STORAGE_MODE=InMemory

ROVER_ROUTING_MODE=Google
GOOGLE_ROUTES_API_KEY=
ROVER_LOCAL_DISCOVERY_MODE=GooglePlaces
ROVER_DISCOVERY_MODE=GooglePlaces
ROVER_CONVERSATION_MODE=OpenAI

ROVER_LOCATION_PROVIDER_MAPBOX_ENABLED=false
ROVER_LOCATION_PROVIDER_WIKIPEDIA_ENABLED=true
ROVER_LOCATION_PROVIDER_WIKIDATA_ENABLED=true
ROVER_LOCATION_PROVIDER_PARKSCANADAHERITAGE_ENABLED=false
ROVER_LOCATION_PROVIDER_GOOGLEPLACES_ENABLED=true
ROVER_LOCATION_PROVIDER_OPENSTREETMAP_ENABLED=true
ROVER_LOCATION_PROVIDER_WEATHER_ENABLED=true
ROVER_LOCATION_STORY_OPENAI_ENABLED=true
ROVER_LOCATION_STORAGE_ENABLED=true
# ROVER_LOCATION_STORAGE_DIRECTORY=work/location-intelligence

# Phase 15 remains disabled until its package and Fold7 field gates pass.
ROVER_PHASE15_ENABLED=false
ROVER_PHASE15_CORRIDOR_ENABLED=false
ROVER_PHASE15_EVIDENCE_PREFETCH_ENABLED=false
ROVER_PHASE15_STORY_PACK_V2_ENABLED=false
ROVER_PHASE15_HISTORICAL_RETRIEVAL_ENABLED=false
ROVER_PHASE15_LIVE_WEATHER_ENABLED=false
ROVER_PHASE15_EVENTS_ENABLED=false
ROVER_PHASE15_CURRENT_INFO_ENABLED=false
ROVER_PHASE15_NARRATIVE_ARC_ENABLED=false
ROVER_PHASE15_SCHEDULER_ENABLED=false
ROVER_PHASE16_ENABLED=false

# Phase 15.4 server-side live providers. Use separately restricted server keys.
# GOOGLE_WEATHER_API_KEY=replace-with-server-google-weather-key
# TICKETMASTER_DISCOVERY_API_KEY=replace-with-ticketmaster-discovery-key

MAPBOX_DIRECTIONS_TOKEN=replace-with-mapbox-token
MAPBOX_SEARCH_TOKEN=replace-with-mapbox-token

# Server-side Google Places API (New) key. Do not reuse the Android-restricted Maps SDK key.
GOOGLE_PLACES_API_KEY=replace-with-server-google-places-key

OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# OPENAI_WEB_SEARCH_ENABLED=true

ElevenLabs__Enabled=true
ElevenLabs__ApiKey=replace-with-elevenlabs-key
ElevenLabs__VoiceId=replace-with-elevenlabs-voice-id
ElevenLabs__ModelId=eleven_multilingual_v2

# Optional weather provider.
# OPENWEATHER_API_KEY=replace-with-openweather-key

# Optional PostgreSQL mode.
# ROVER_POSTGRES_PASSWORD=change-me-local-only
# ROVER_CONNECTION_STRING=Host=localhost;Port=5432;Database=rover;Username=rover;Password=change-me-local-only
